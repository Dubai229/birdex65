// Выкладка на Cloudflare, если сборка запускается из корня репо (Root directory = /).
// Корневой "npm run build" собирает apps/web, результат лежит в apps/web/dist.
{
  "name": "birdex",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
